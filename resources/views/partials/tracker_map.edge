{{--
  Tracker map partial.
  Requires `lastLocation` in scope (set by HomeController).
  Leaflet is loaded via Vite bundle (tracker-map.js).
--}}
<div class="tracker-card">

  @if(lastLocation)
    <div
      id="tracker-map"
      class="tracker-map-live"
      data-lat="{{ lastLocation.lat }}"
      data-lng="{{ lastLocation.lng }}"
    ></div>
  @else
    <div class="tracker-map-live tracker-map-empty">
      <span>Aucune donnée GPS</span>
    </div>
  @end

  <div class="tracker-card-body">
    <div class="tracker-name-battery">
      Tracker
      @if(lastLocation)
        <span class="tracker-battery">{{ (lastLocation.speed * 3.6).toFixed(1) }} km/h</span>
      @end
    </div>

    @if(lastLocation)
      <div class="tracker-added-date">
        Dernière position : {{ new Date(lastLocation.created_at).toLocaleString('fr-FR') }}
      </div>
      <div class="tracker-status" style="color: var(--accent-green)">EN LIGNE</div>
    @else
      <div class="tracker-added-date">Aucune donnée</div>
      <div class="tracker-status" style="color: var(--text-muted)">HORS LIGNE</div>
    @end

    <div class="tracker-actions">
      @if(lastLocation)
        <a
          href="https://www.google.com/maps?q={{ lastLocation.lat }},{{ lastLocation.lng }}"
          class="btn-card-white"
          target="_blank"
          rel="noopener"
        >Ouvrir dans Maps</a>
      @else
        <span class="btn-card-white" style="opacity:0.4;cursor:default">Ouvrir dans Maps</span>
      @end
      <button class="btn-card-danger" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
        Supprimer
      </button>
    </div>
  </div>
</div>

@if(lastLocation)
  @vite(['resources/js/tracker-map.js'])
@end
